# Bridge service configuration. Copy to office-sign.env for local use.
MQTT_HOST=mosquitto
MQTT_PORT=1883
TOPIC_STATE=office/sign/state
TOPIC_RING=office/sign/ring
TEAMS_WEBHOOK=
FLOW_URL=
NTFY_URL=
NTFY_STATUS_URL=
NTFY_STATUS_TOPIC=
LISTEN_ADDR=0.0.0.0
LISTEN_PORT=8787
SHARED_SECRET=replace-with-a-long-random-value
PUBLISH_INTERVAL=0
DISPLAY_TZ=Europe/London
RAD_URL=
RAD_USER=
RAD_PASS=
RAD_PATH=/user/calendar/
ICS_CALENDAR_URL=
ICS_POLL_INTERVAL=60
